@page
@model FindIt.Pages.ObjetosModel

@{
    ViewData["Title"] = "Buscar objetos";
}

<style>
    .encabezado-busqueda {
        background-color: #eef5ff;
        border: 1px solid #dbeafe;
        border-radius: 14px;
        padding: 25px;
    }

    .tarjeta-objeto {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .tarjeta-objeto:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.10);
        }

    .imagen-objeto {
        width: 100%;
        height: 220px;
        object-fit: contain;
        background-color: #f8fafc;
        padding: 8px;
        display: block;
    }

    .sin-imagen {
        height: 180px;
        background-color: #f1f5f9;
        color: #64748b;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 8px;
    }

    .descripcion-objeto {
        background-color: #f8fafc;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 15px;
        overflow-wrap: anywhere;
    }

    .dato-objeto {
        margin-bottom: 9px;
        overflow-wrap: anywhere;
    }

    .acciones-objeto {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 15px;
    }

        .acciones-objeto form {
            margin: 0;
        }
</style>

<div class="container mt-4">

    <div class="encabezado-busqueda mb-4">
        <h1 class="text-primary">Buscar objetos</h1>
        <p class="mb-0">
            Consulta los objetos perdidos o encontrados registrados en FindIt.
        </p>
    </div>

    <!-- Filtros de búsqueda -->
    <form method="get"
          action="/Objetos"
          class="card card-body shadow-sm mb-4">

        <div class="row g-3">

            <div class="col-md-6">
                <label for="Busqueda" class="form-label">
                    Buscar
                </label>

                <input id="Busqueda"
                       name="Busqueda"
                       value="@Model.Busqueda"
                       class="form-control"
                       placeholder="Nombre, descripción o ubicación" />
            </div>

            <div class="col-md-6">
                <label for="Tipo" class="form-label">
                    Tipo de reporte
                </label>

                <select id="Tipo" name="Tipo" class="form-select">
                    <option value="">Todos</option>

                    <option value="Perdido"
                            selected="@(Model.Tipo == "Perdido")">
                        Perdido
                    </option>

                    <option value="Encontrado"
                            selected="@(Model.Tipo == "Encontrado")">
                        Encontrado
                    </option>
                </select>
            </div>

            <div class="col-md-6">
                <label for="Categoria" class="form-label">
                    Categoría
                </label>

                <select id="Categoria"
                        name="Categoria"
                        class="form-select">

                    <option value="">Todas las categorías</option>

                    @foreach (var categoria in Model.Categorias)
                    {
                        <option value="@categoria"
                                selected="@(Model.Categoria == categoria)">
                            @categoria
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label for="EstadoFiltro" class="form-label">
                    Estado
                </label>

                <select id="EstadoFiltro"
                        name="EstadoFiltro"
                        class="form-select">

                    <option value="">Todos</option>

                    <option value="Pendiente"
                            selected="@(Model.EstadoFiltro == "Pendiente")">
                        Pendiente
                    </option>

                    <option value="Resuelto"
                            selected="@(Model.EstadoFiltro == "Resuelto")">
                        Resuelto
                    </option>

                    <option value="Activo"
                            selected="@(Model.EstadoFiltro == "Activo")">
                        Activo
                    </option>

                    <option value="Cerrado"
                            selected="@(Model.EstadoFiltro == "Cerrado")">
                        Cerrado
                    </option>
                </select>
            </div>

        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                Buscar
            </button>

            <a href="/Objetos" class="btn btn-secondary">
                Limpiar filtros
            </a>
        </div>
    </form>

    <!-- Listado de objetos -->
    @if (Model.Objetos == null || Model.Objetos.Count == 0)
    {
        <div class="alert alert-info">
            No se encontraron objetos con los criterios seleccionados.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var objeto in Model.Objetos)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card tarjeta-objeto h-100 shadow-sm">

                        <!-- Fotografía -->
                        @if (!string.IsNullOrWhiteSpace(objeto.FotoURL))
                        {
                            <img src="@objeto.FotoURL"
                                 alt="Fotografía de @objeto.Nombre"
                                 class="imagen-objeto"
                                 loading="lazy"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <div class="sin-imagen" style="display:none;">
                                <span style="font-size: 36px;">📷</span>
                                <span>Imagen no disponible</span>
                            </div>
                        }
                        else
                        {
                            <div class="sin-imagen">
                                <span style="font-size: 36px;">📷</span>
                                <span>Sin fotografía</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title text-primary">
                                @objeto.Nombre
                            </h5>

                            <div class="descripcion-objeto">
                                <strong>Descripción:</strong>

                                <p class="mb-0 mt-2">
                                    @if (!string.IsNullOrWhiteSpace(objeto.Descripcion))
                                    {
                                        @objeto.Descripcion
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Sin descripción registrada.
                                        </span>
                                    }
                                </p>
                            </div>

                            <p class="dato-objeto">
                                <strong>Tipo:</strong>
                                @objeto.TipoReporte
                            </p>

                            <p class="dato-objeto">
                                <strong>Categoría:</strong>
                                @objeto.Categoria
                            </p>

                            <p class="dato-objeto">
                                <strong>Ubicación:</strong>
                                @objeto.Ubicacion
                            </p>

                            <p class="dato-objeto">
                                <strong>Estado:</strong>
                                @objeto.Estado
                            </p>

                            <!-- Acciones solo para el propietario -->
                            <div class="mt-auto">

                                @if (Model.UsuarioActualId.HasValue &&
                                     objeto.UsuarioID == Model.UsuarioActualId.Value)
                                {
                                    <div class="acciones-objeto">

                                        <a asp-page="/Editar"
                                           asp-route-id="@objeto.IdObjeto"
                                           class="btn btn-warning">
                                            ✏️ Editar
                                        </a>

                                        <form method="post"
                                              asp-page="/Objetos"
                                              asp-page-handler="Eliminar"
                                              asp-route-id="@objeto.IdObjeto"
                                              onsubmit="return confirm('¿Estás seguro de que deseas eliminar este reporte?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                🗑️ Eliminar
                                            </button>

                                        </form>

                                    </div>
                                }

                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
