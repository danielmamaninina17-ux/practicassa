@page
@model FindIt.Pages.LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<style>
    .login-contenedor {
        max-width: 450px;
        margin: 50px auto;
        padding: 20px;
    }

    .login-tarjeta {
        padding: 30px;
        background: white;
        border: 1px solid #dbe4f0;
        border-radius: 16px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.07);
    }

    .login-encabezado {
        text-align: center;
        margin-bottom: 25px;
    }

        .login-encabezado h1 {
            color: #174ea6;
            margin-bottom: 8px;
        }

    .login-campo {
        margin-bottom: 18px;
    }

        .login-campo label {
            display: block;
            font-weight: bold;
            margin-bottom: 7px;
        }

        .login-campo input {
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 15px;
        }

            .login-campo input:focus {
                outline: 2px solid #93c5fd;
                border-color: #174ea6;
            }

    .boton-login {
        width: 100%;
        padding: 13px;
        background: #174ea6;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

        .boton-login:hover {
            background: #123b7a;
        }

    .login-nota {
        margin-top: 20px;
        text-align: center;
        color: #64748b;
        font-size: 14px;
    }

        .login-nota a {
            color: #174ea6;
            font-weight: bold;
            text-decoration: none;
        }

            .login-nota a:hover {
                text-decoration: underline;
            }
</style>

<div class="login-contenedor">
    <div class="login-tarjeta">

        <div class="login-encabezado">
            <h1>Iniciar sesión</h1>
            <p>Bienvenido a FindIt. Ingresa a tu cuenta.</p>
        </div>

        <form method="post">

            <div asp-validation-summary="All"
                 style="color: #dc3545; margin-bottom: 15px;">
            </div>

            <div class="login-campo">
                <label asp-for="Correo">Correo electrónico</label>
                <input asp-for="Correo"
                       type="email"
                       placeholder="correo@ejemplo.com"
                       autocomplete="email" />
                <span asp-validation-for="Correo"
                      style="color: #dc3545;">
                </span>
            </div>

            <div class="login-campo">
                <label asp-for="Contrasena">Contraseña</label>
                <input asp-for="Contrasena"
                       type="password"
                       placeholder="Ingresa tu contraseña"
                       autocomplete="current-password" />
                <span asp-validation-for="Contrasena"
                      style="color: #dc3545;">
                </span>
            </div>

            <button type="submit" class="boton-login">
                Iniciar sesión
            </button>

        </form>

        <p class="login-nota">
            ¿No tienes una cuenta?
            <a asp-page="/Registro">Crear cuenta</a>
        </p>

    </div>
</div>
